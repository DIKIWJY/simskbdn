# ─────────────────────────────────────────────────────────────────────────────
# SIMSKBDN — .env.example
# Salin ke ".env" dan isi semua nilai sebelum menjalankan sistem.
# JANGAN commit file .env ke Git!
# ─────────────────────────────────────────────────────────────────────────────

# ── Database PostgreSQL ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=pusri_user
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT_MIN_20_KARAKTER
DB_NAME=pusri_db
# Untuk production: "require" (enkripsi koneksi ke DB)
# Untuk development lokal: "disable"
DB_SSL_MODE=disable

# ── JWT ───────────────────────────────────────────────────────────────────────
# WAJIB minimal 32 karakter acak. Generate dengan: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER_CONTOH_abc123xyz
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=168h

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=development
# URL frontend untuk: link di email notifikasi + validasi CORS + WebSocket origin
APP_URL=http://localhost:3000
# Tambahan origin yang diizinkan (pisahkan dengan koma, misal staging URL):
# CORS_EXTRA_ORIGINS=https://staging.simskbdn.pusri.co.id

# ── MinIO (penyimpanan file PDF) ──────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=GANTI_DENGAN_PASSWORD_MINIO_KUAT
MINIO_BUCKET=pusri-documents
MINIO_USE_SSL=false

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Gmail: gunakan App Password (bukan password akun biasa)
# Aktifkan di: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email_simskbdn@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=email_simskbdn@gmail.com
