# ─────────────────────────────────────────────────────────────────────────────
# SIMSKBDN — .env.example
# PT Pupuk Sriwidjaja Palembang
#
# Salin file ini menjadi ".env":
#   cp .env.example .env
# Lalu isi semua nilai bertanda GANTI_INI sebelum menjalankan sistem.
# File ".env" JANGAN di-commit ke Git (sudah ada di .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Database PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_USER=pusri_user
DB_PASSWORD=GANTI_INI_password_database_kuat
DB_NAME=pusri_db
DB_SSL_MODE=disable

# JWT (generate: openssl rand -hex 32) — minimal 32 karakter
JWT_SECRET=GANTI_INI_string_acak_minimal_32_karakter
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=168h

# Server
PORT=8080
APP_ENV=development
APP_URL=http://localhost:3000

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=GANTI_INI_password_minio_kuat
MINIO_BUCKET=pusri-documents
MINIO_USE_SSL=false

# Email SMTP (opsional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email_sistem@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=email_sistem@gmail.com
